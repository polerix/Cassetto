{
  "name": "cassetto",
  "version": "1.0.0",
  "description": "Portable WAV Audio Recorder",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --publish never",
    "build:mac": "electron-builder --mac --publish never",
    "build:all": "electron-builder --win --mac --publish never"
  },
  "keywords": [
    "cassetto",
    "audio",
    "recorder",
    "wav",
    "portable",
    "electron",
    "macos",
    "mac"
  ],
  "author": "Cassetto",
  "license": "MIT",
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.cassetto.recorder",
    "productName": "Cassetto",
    "publish": null,
    "directories": {
      "output": "dist"
    },
    "win": {
      "executableName": "Cassetto",
      "target": [
        "portable",
        "dir"
      ],
      "icon": "assets/cassette.ico",
      "forceCodeSigning": false
    },
    "portable": {
      "artifactName": "Cassetto.exe",
      "requestExecutionLevel": "user"
    },
    "mac": {
      "category": "public.app-category.music",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icon-mac.png",
      "artifactName": "Cassetto.${ext}"
    },
    "dmg": {
      "artifactName": "Cassetto.dmg"
    }
  }
}
